# Local development. Copy to .env (git-ignored).
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared secret: the same value as INFERENCE_API_KEY in canonevent-backend.
INFERENCE_API_KEY=

# Speech-to-text (/transcribe returns 503 without it).
SARVAM_API_KEY=

# Embeddings: Ollama on the host (`ollama pull bge-m3`).
EMBED_BACKEND=ollama
EMBED_MAX_BATCH=64
OLLAMA_EMBED_MODEL=bge-m3
# Defaults to the host's Ollama (http://host.docker.internal:11434); set
# http://ollama:11434 when running the `ollama` compose profile.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_PULL_MODELS=bge-m3

# Port to publish, if 8001 is taken.
# INFERENCE_PORT=8001
