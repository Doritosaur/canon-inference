# Production (compose.prod.yaml). Copy to .env (git-ignored).
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Shared secret: the same value as INFERENCE_API_KEY in canonevent-backend.
INFERENCE_API_KEY=

# Speech-to-text (/transcribe returns 503 without it).
SARVAM_API_KEY=

# Embeddings: Cloudflare Workers AI (bge-m3, 1024-d).
EMBED_BACKEND=api
EMBED_MAX_BATCH=64
EMBED_API_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
EMBED_API_KEY=<cloudflare api token with Workers AI permission>
EMBED_API_MODEL=@cf/baai/bge-m3

# Empty: no Ollama container, since embeddings come from Workers AI.
COMPOSE_PROFILES=

# INFERENCE_MEMORY=1g
